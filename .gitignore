# Dependencies
node_modules/

# Build output
dist/
build/
web-build/
*.tsbuildinfo

# Expo
.expo/
expo-env.d.ts

# Environment / secrets, never commit real values
.env
.env.*
!.env.example

# Test / tooling artifacts
coverage/
.vitest/
.eslintcache

# Local virtual environments (if you add a Python service)
.venv/
venv/
__pycache__/

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Design-handoff mockup HTML, kept local (~3MB, base64-laden, trips the secret scan).
# The README + screenshots in this dir ARE committed as the build reference.
docs/design/redesign/*.html

# Local AI working doc, kept out of the public repo
CLAUDE.md

# Local "what's left" working list, kept out of the public repo
WHATS-LEFT.md

# Bug screenshots + recordings from Android testing, dropped here from the phone via OneDrive.
# Kept out of git: they can hold real task text and would bloat history. OneDrive backs them up.
bugs/

# Pitch and portfolio exports: the HTML/PDF/PNG pieces made to show DoubleDone to a
# particular audience (an interview, a narrative walk-through), not to run or document it.
# They are regenerable from their design source, several are 500KB binaries that would sit
# in history forever, and some name a specific company. Product docs are NOT covered here:
# the Connect-Claude user guide and the design-source design prompts are repo material and
# stay trackable. The `docs/doubledone-*` prefix is the export pipeline's own naming.
docs/doubledone-*
docs/design-source/sinch-brief.html
docs/design-source/insight-map.html

# Wrangler local dev secrets (never commit)
.dev.vars

# Wrangler local dev state (miniflare)
.wrangler/
